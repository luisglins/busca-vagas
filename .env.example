# Copie este arquivo para .env.local e preencha. O .env.local NÃO vai para o git.

# Jooble (chave brasileira: br.jooble.org/api/about). Sem chave, a Jooble fica de fora da busca.
JOOBLE_API_KEY=
# Opcional: host da Jooble (padrão br.jooble.org)
JOOBLE_HOST=
# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor, nunca no navegador
SUPABASE_SECRET_KEY=
